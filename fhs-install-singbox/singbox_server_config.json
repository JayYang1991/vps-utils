{
  "log": {
    "level": "{SINGBOX_LOG_LEVEL}",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "0.0.0.0",
      "listen_port": {SINGBOX_SOCKS_PORT},
      "users": [
        {
          "username": "{SINGBOX_SOCKS_USER}",
          "password": "{SINGBOX_SOCKS_PASS}"
        }
      ]
    },
    {
      "type": "vless",
      "tag": "vless-grpc",
      "listen": "127.0.0.1",
      "listen_port": 8088,
      "users": [
        {
          "uuid": "{SINGBOX_UUID}",
          "flow": ""
        }
      ],
      "transport": {
        "type": "ws",
        "path": "{SINGBOX_WS_PATH}",
        "headers": {
          "Host": "{SINGBOX_WS_HOST}"
        }
      }
    },
    {
      "type": "vless",
      "tag": "vless-reality",
      "listen": "0.0.0.0",
      "listen_port": 8443,
      "users": [
        {
          "uuid": "{SINGBOX_UUID}",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "{SINGBOX_DOMAIN}",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "{SINGBOX_DOMAIN}",
            "server_port": 443
          },
          "private_key": "{SINGBOX_PRIVATE_KEY}",
          "short_id": [
            "{SINGBOX_SHORT_ID}"
          ]
        }
      }
    },
    {
      "type": "vless",
      "tag": "vless-reality-443",
      "listen": "0.0.0.0",
      "listen_port": 443,
      "users": [
        {
          "uuid": "{SINGBOX_UUID}",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "{SINGBOX_DOMAIN}",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "{SINGBOX_DOMAIN}",
            "server_port": 443
          },
          "private_key": "{SINGBOX_PRIVATE_KEY}",
          "short_id": [
            "{SINGBOX_SHORT_ID}"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "socks",
      "tag": "socks-2028",
      "server": "{SOCKS_OUT_SERVER}",
      "server_port": {SOCKS_OUT_PORT}
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": [
          "vless-reality-443"
        ],
        "outbound": "socks-2028"
      }
    ]
  }
}
