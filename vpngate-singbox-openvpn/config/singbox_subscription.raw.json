{
  "log": {
    "level": "warning",
    "timestamp": true
  },
  "dns": {
    "strategy": "ipv4_only",
    "independent_cache": true,
    "servers": [
      {
        "tag": "dns-direct",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns-remote",
        "type": "udp",
        "server": "8.8.8.8",
        "detour": "openvpn-out"
      }
    ],
    "final": "dns-remote"
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 1080,
      "sniff": true
    },
    {
      "type": "socks",
      "tag": "public-socks-in",
      "listen": "0.0.0.0",
      "listen_port": 2080,
      "sniff": true
    }
  ],
  "route": {
    "default_domain_resolver": "dns-remote",
    "rules": [
      {
        "inbound": [
          "socks-in"
        ],
        "outbound": "auto-selector-tcp"
      },
      {
        "inbound": [
          "public-socks-in"
        ],
        "outbound": "openvpn-out"
      }
    ],
    "final": "auto-selector-tcp"
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "urltest",
      "tag": "auto-selector-tcp",
      "outbounds": [
        "direct"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    {
      "type": "direct",
      "tag": "openvpn-out",
      "bind_interface": "tun0",
      "domain_resolver": "dns-remote"
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db"
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090"
    }
  }
}