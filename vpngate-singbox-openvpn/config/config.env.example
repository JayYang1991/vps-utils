# ==============================================================================
# vpngate-singbox-openvpn 容器统一配置文件
# 所有配置项均支持在此定义，容器启动时自动读取此文件
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sing-box 订阅与入站配置
# ------------------------------------------------------------------------------
# Sing-box 订阅链接 (支持直接返回 JSON 格式或 Base64 编码的配置)
SINGBOX_SUBSCRIPTION_URL="https://example.com/api/v1/client/subscribe?token=your_token_here"

# 内部 SOCKS 入站监听地址与端口 (仅供容器内 OpenVPN 出站专用，监听 127.0.0.1)
SOCKS_INBOUND_LISTEN="127.0.0.1"
SOCKS_INBOUND_PORT=1080
SOCKS_INBOUND_TAG="socks-in"

# 外部公开 SOCKS 入站端口 (映射至宿主机，供宿主机或局域网其它客户端使用，默认 2080)
PUBLIC_SOCKS_PORT=2080
PUBLIC_SOCKS_TAG="public-socks-in"

# 目标 urltest 节点组 Tag 标签 (留空时将自动扫描配置中首个 type 为 urltest 或 selector 的出站组)
TARGET_URLTEST_TAG=""

# 可选：是否额外开放一个公网/局域网混合代理端口 (如 7890，填 0 则不开放)
MIXED_INBOUND_PORT=0

# 可选：订阅自动更新周期 (小时，填 0 则不自动定时拉取)
SINGBOX_UPDATE_INTERVAL_HOURS=12

# ------------------------------------------------------------------------------
# 2. OpenVPN 客户端与远程配置更新
# ------------------------------------------------------------------------------
# OpenVPN 出站是否通过代理 (默认: false / 直连不使用代理; 设为 true 时通过 Sing-box SOCKS5 出站)
OPENVPN_USE_PROXY="false"

# OpenVPN 配置文件名 (位于映射的主机 config 目录下，默认为 client.ovpn)
OPENVPN_CONFIG_FILE="client.ovpn"

# 当 OpenVPN 当前节点失效时，远程获取新 .ovpn 配置文件的 URL
# 支持对接 vpngate-residential-selector 的 exporter 接口或外部 HTTP API
OVPN_REMOTE_URL="http://127.0.0.1:8080/export/ovpn"

# OpenVPN 用户名与密码 (VPNGate 默认常用用户名: vpn, 密码: vpn)
OPENVPN_AUTH_USER="vpn"
OPENVPN_AUTH_PASS="vpn"

# ------------------------------------------------------------------------------
# 3. 后台健康监控与自动故障切换
# ------------------------------------------------------------------------------
# 监控检查间隔时间 (单位: 秒)
CHECK_INTERVAL=30

# 连续失败多少次后触发重新下载 .ovpn 并重启 OpenVPN
CHECK_FAIL_THRESHOLD=3

# 检查 OpenVPN (tun0 接口) 连通性的测试目标 URL (HTTP GET)
CHECK_TARGET_URL="https://api.ipify.org"

# 单次网络连通性检测超时时间 (单位: 秒)
CHECK_TIMEOUT=10

# ------------------------------------------------------------------------------
# 4. 宿主机节点池自动刷新与定时任务 (每天北京时间 00:00 - 06:00 随机时间点)
# ------------------------------------------------------------------------------
# 每天定时执行时间窗口 (北京时间 0-23 小时，默认: 0 点至 6 点)
AUTO_UPDATE_START_HOUR=0
AUTO_UPDATE_END_HOUR=6

# 刷新节点时的目标国家代码过滤 (留空为不过滤全部国家; 指定单个国家如 JP, US, KR 或多个国家逗号分隔如 JP,US)
VPNGATE_COUNTRY=""

# 刷新节点时的最小带宽过滤阈值 (单位: Mbps，默认: 0.0)
VPNGATE_MIN_SPEED=0.0

# 刷新节点时的保留数量 (默认: 100)
VPNGATE_LIMIT=100

# 刷新节点时的自定义 CSV 数据源路径或 URL (留空则自动从 VPNGate 官方/镜像下载)
VPNGATE_CSV_SOURCE=""

# 最大允许的 Scamalytics 威胁分阈值 (默认: 20，仅保留威胁分低于 20 的纯净低风险住宅节点)
VPNGATE_MAX_THREAT_SCORE=20

